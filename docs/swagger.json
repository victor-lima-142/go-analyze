{
    "swagger": "2.0",
    "info": {
        "description": "Esta é a API do analisador de recursos e custos de workloads Kubernetes (go-analyze).",
        "title": "Go Analyze API",
        "contact": {
            "name": "Suporte Go-Analyze"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/v1/audit": {
            "get": {
                "description": "Recalcula os custos de CPU e memória com implementação independente e verifica apenas a consistência interna do valor reportado; não valida faturamento real.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "audit"
                ],
                "summary": "Auditar projeção de custo",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Período rápido (ex: 1hr, 5d, 10d)",
                        "name": "period",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Data inicial (RFC3339)",
                        "name": "start_at",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Data final",
                        "name": "end_at",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Inclui ponto-a-ponto",
                        "name": "details",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.AuditResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/consolidated": {
            "get": {
                "description": "Retorna uma lista paginada das consolidações salvas no banco de dados, com filtros de data opcionais e opção de incluir workloads detalhados.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "consolidated"
                ],
                "summary": "Listar consolidações históricas",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Número da página (padrão: 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Tamanho da página (padrão: 50, máx: 1000)",
                        "name": "pageSize",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Limite alternativo de tamanho de página",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Se deve incluir itens consolidados de workloads (padrão: true)",
                        "name": "include_items",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Período rápido (ex: 1min, 5min, 10min, 30min, 1hr, 5d, 10d)",
                        "name": "period",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Data inicial (ex: RFC3339 ou 2006-01-02)",
                        "name": "start_at",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Data final",
                        "name": "end_at",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.PaginatedConsolidatedResponse"
                        }
                    },
                    "400": {
                        "description": "Parâmetros de filtro ou data inválidos",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "405": {
                        "description": "Método HTTP não permitido",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Erro interno ao consultar o banco de dados",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/experiment/reset": {
            "post": {
                "description": "Limpa as tabelas de histórico do banco de dados e zera o estado interno dos trackers de notificação para uma nova rodada de teste.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "experiment"
                ],
                "summary": "Resetar dados do experimento",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Bearer token experimental",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "405": {
                        "description": "Method Not Allowed",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/indicators": {
            "get": {
                "description": "Calcula e retorna os indicadores atuais de otimização de recursos a partir do Prometheus.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "indicators"
                ],
                "summary": "Obter indicadores calculados atuais",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Janela de tempo para o cálculo (ex: 30s, 1m, 5m, 10m, 30m, 1h)",
                        "name": "window",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Número da página (padrão: 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Tamanho da página (padrão: 50, máx: 1000)",
                        "name": "pageSize",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Limite alternativo de tamanho de página",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filtrar por Namespace do Kubernetes",
                        "name": "namespace",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filtrar por Pod do Kubernetes",
                        "name": "pod",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filtrar por Container do Kubernetes",
                        "name": "container",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.PaginatedIndicatorResponse"
                        }
                    },
                    "405": {
                        "description": "Método HTTP não permitido",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "502": {
                        "description": "Falha ao consultar o Prometheus ou calcular indicadores",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/workloads/details": {
            "get": {
                "description": "Retorna as métricas atuais de execução em tempo real e um histórico das consolidações registradas para o workload. O parâmetro `pod` é tratado como prefixo (LIKE) quando não contém o caractere %.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "workloads"
                ],
                "summary": "Obter detalhes de um workload específico",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Namespace do Kubernetes",
                        "name": "namespace",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Nome do Container no Kubernetes",
                        "name": "container",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Prefixo do Pod no Kubernetes (LIKE)",
                        "name": "pod",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Janela de tempo para o cálculo atual",
                        "name": "window",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Período rápido para busca histórica (ex: 1hr, 5d, 10d)",
                        "name": "period",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Data inicial para histórico (ex: RFC3339)",
                        "name": "start_at",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Data final para histórico",
                        "name": "end_at",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Número máximo de pontos históricos a retornar (padrão: 10)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.WorkloadDetailsResponse"
                        }
                    },
                    "400": {
                        "description": "Namespace e container são parâmetros obrigatórios ou datas inválidas",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "405": {
                        "description": "Método HTTP não permitido",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Erro ao carregar os dados históricos",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    },
